GROQ_API_KEY=
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_USD=
RAZORPAY_PLAN_STARTER_INR=
RAZORPAY_PLAN_PRO_USD=
RAZORPAY_PLAN_PRO_INR=
RAZORPAY_PLAN_BUSINESS_USD=
RAZORPAY_PLAN_BUSINESS_INR=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=replace-with-a-64-character-random-string-for-local-development

# Cloudflare AI Gateway & Unified Billing Configuration
CF_AIG_GATEWAY_NAME=
CLOUDFLARE_API_TOKEN=
TEXT_MODEL=google-ai-studio/gemini-1.5-flash
# Explicit override for Stage 2 text generation fallback provider ("groq" | "gemini"). Only affects Stage 2 text, not vision.
TEXT_FALLBACK_PROVIDER= 

# Omnipost Vault Encryption Key (64-character hex string / 256-bit key)
OMNIPOST_MASTER_KEY=

# assets page media providers — paste keys here, restart `npm run dev`
# At minimum add PEXELS_API_KEY (free). Openverse + Iconify work with NO keys.

# Pexels — https://www.pexels.com/api/ (free, instant access)
PEXELS_API_KEY=

# Pixabay — https://pixabay.com/api/docs/ (free, requires registration)
PIXABAY_API_KEY=

# Unsplash — https://unsplash.com/developers (free, requires app creation)
UNSPLASH_ACCESS_KEY=

# Google Fonts — https://developers.google.com/fonts/docs/developer_api (optional)
GOOGLE_FONTS_API_KEY=
